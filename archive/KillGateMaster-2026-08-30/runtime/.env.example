# Killgate Runtime v1.2.0 (release correctness update: 2026-08-30)
APP_ENV=development
LOG_LEVEL=INFO

# Local developer mode (no account or cloud required)
AUTH_MODE=local
STATE_BACKEND=local
COOKIE_SECURE=0
# Session cookie lifetime in seconds (default 30 days).
SESSION_COOKIE_MAX_AGE=2592000
LOCAL_USER_ID=local-user
LOCAL_USER_EMAIL=local@killgate.dev

# Production account/cloud mode
# APP_ENV=production
# OPENAI_REQUIRED=1
# PUBLIC_APP_ORIGIN=https://YOUR_PRODUCTION_HOST
# PRIVACY_CONTACT_EMAIL=privacy@YOUR_DOMAIN
# SUPPORT_EMAIL=support@YOUR_DOMAIN
# AUTH_MODE=supabase
# STATE_BACKEND=supabase
# WALLET_BACKEND=supabase
# COOKIE_SECURE=1
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Never put this in the PWA, TWA, APK, or public repo.
# SUPABASE_SECRET_KEY=sb_secret_...
# Signup/login protection. Raise global/source caps only after custom SMTP,
# domain authentication, and bot protection are configured in Supabase Auth.
# KILLGATE_LOGIN_ACCOUNT_LIMIT_15M=10
# KILLGATE_LOGIN_SOURCE_LIMIT_15M=50
# KILLGATE_LOGIN_GLOBAL_LIMIT_15M=500
# KILLGATE_SIGNUP_ACCOUNT_LIMIT_1H=5
# KILLGATE_SIGNUP_SOURCE_LIMIT_1H=40
# KILLGATE_SIGNUP_GLOBAL_LIMIT_1H=1000

# AI/research credentials — server only. Never commit a real key.
# OPENAI_API_KEY=
# DEEP_RESEARCH_ENABLED=0
# DEEP_RESEARCH_MAX_MODEL_CALLS=12
# DEEP_RESEARCH_MAX_SEARCH_CALLS=24
# DEEP_RESEARCH_MAX_TOOL_CALLS=8
# DEEP_RESEARCH_PLANNER_MODEL=gpt-5.6-luna
# DEEP_RESEARCH_EXTRACTOR_MODEL=gpt-5.6-luna
# DEEP_RESEARCH_CONTRADICTION_MODEL=gpt-5.6-luna
# DEEP_RESEARCH_SYNTHESIS_MODEL=gpt-5.6-terra
# DEEP_RESEARCH_CRITIC_MODEL=gpt-5.6-luna
# DEEP_RESEARCH_ALLOW_SOL=0
# DEEP_RESEARCH_SOFT_COST_LIMIT_USD=0.60
# DEEP_RESEARCH_HARD_COST_LIMIT_USD=1.25
# DEEP_RESEARCH_WORKER_MODE=inline
# DEEP_RESEARCH_TASK_QUEUE=
# DEEP_RESEARCH_WORKER_URL=
# DEEP_RESEARCH_TASK_AUDIENCE=
# Production requires 1. The local fallback treats snippets as leads and can never PASS.
OPENAI_REQUIRED=0
MODEL_NAME=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=2400
RESEARCH_RUNS_PER_HOUR=8
# API safety ceiling only; this is NOT a plan allowance. Paid usage is controlled by passes/credits.
RESEARCH_SAFETY_CAP_30D=30
# Internal beta testing only. Allowlisted accounts receive up to nine free runs
# during one fourteen-day window. Never enable for a Play release.
# KILLGATE_BETA_ENABLED=1
# KILLGATE_BETA_USER_IDS=SUPABASE_AUTH_USER_UUIDS
# KILLGATE_BETA_START_AT=2026-08-28T00:00:00Z
# KILLGATE_BETA_DURATION_DAYS=14
# KILLGATE_BETA_MAX_RUNS=9
# Internal admin testing only. Requires both values; never enable for a Play release.
# KILLGATE_TEST_ADMIN_ENABLED=1
# KILLGATE_TEST_ADMIN_USER_IDS=SUPABASE_AUTH_USER_UUID

# Google Play billing. Keep BILLING_ENFORCED=0 until the Play products,
# service-account access, and an internal-test release are all configured.
BILLING_ENFORCED=0
# Paid authorization fails closed when the stored Play verification is older than this bound.
ENTITLEMENT_MAX_AGE_HOURS=24
# GOOGLE_PLAY_PACKAGE_NAME=com.example.killgate
# PLAY_APP_SIGNING_SHA256=AA:BB:... (Play Console app-signing certificate fingerprint)
# GOOGLE_PLAY_VENTURE_PASS_PRODUCT_ID=killgate_venture_pass
# GOOGLE_PLAY_EVIDENCE_RUN_PRODUCT_ID=killgate_evidence_run
# GOOGLE_PLAY_FOUNDER_PRO_PRODUCT_ID=killgate_founder_pro
# GOOGLE_PLAY_FOUNDER_TOPUP_PRODUCT_ID=killgate_founder_topup
# GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=/run/secrets/google-play-service-account.json
# Or use GOOGLE_PLAY_SERVICE_ACCOUNT_JSON as a server secret instead of a file.

# Google Play Real-Time Developer Notifications (Cloud Pub/Sub authenticated push).
# Keep Pub/Sub payload unwrapping DISABLED so messageId is available for deduplication.
# GOOGLE_PLAY_RTDN_AUDIENCE=https://YOUR_PRODUCTION_HOST/billing/google-play/rtdn
# GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=killgate-rtdn@YOUR_GCP_PROJECT.iam.gserviceaccount.com

# Optional production error monitoring
# SENTRY_DSN=https://...
# SENTRY_TRACES_SAMPLE_RATE=0.05
